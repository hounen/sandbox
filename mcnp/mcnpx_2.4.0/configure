  if test "$ac_debug" = yes; then
                  FFLAGS="${FFLAGS} "'${FDEBUG}'
      CFLAGS="${CFLAGS} "'${CDEBUG}'
      LDFLAGS="${LDFLAGS} "'${LDDEBUG}'
                           fi


     if test "${LINKMETH}" = shared; then
      FFLAGS="${FFLAGS} "'${SOFFLAGS}'
      CFLAGS="${CFLAGS} "'${SOCFLAGS}'
         fi
      FFLAGS="${FFLAGS} "'${FOPT}'
   CFLAGS="${CFLAGS} "'${COPT}'


                                                                                                                                                                                              
   
   
   
   
   
   
   
   
   
   
   
   
   


