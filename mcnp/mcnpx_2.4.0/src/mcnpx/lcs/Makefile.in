rou16.o rou17.o rou18.o rou19.o rou20.o rou21.o rou22.o rout1.o rout2.o        \
rout3.o rout4.o rout5.o rout6.o rout6a.o rout7.o rout7a.o rout8.o save.o       \
scattl.o selcst.o selj1.o selpt.o set_i.o set_pcap.o setcmg.o setlcs.o         \
setwig.o sgm2.o shxd.o signex.o skale.o skeme.o sliq.o spac32.o spcn.o         \
spisom.o stnew.o stor.o stora.o store.o stph.o stpl.o stpr.o swapp.o           \
