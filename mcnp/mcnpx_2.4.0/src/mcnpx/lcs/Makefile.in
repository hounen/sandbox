nn.o nobal.o nopart.o nucnuc.o onepin.o                                        \
openlcsdata.o pairr.o pangle.o panglk.o partin.o                             \
pclct.o pcol.o pfmax.o pgamma.o pgs.o phase.o phsbst.o phsp0.o pht.o pi.o      \
pih.o pin1pi.o pinst.o pinuc.o plev.o plt.o pmcdg.o pmkd.o poe.o poenew.o      \
