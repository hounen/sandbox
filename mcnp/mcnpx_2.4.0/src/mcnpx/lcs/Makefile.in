# $Id: Makefile.in,v 1.12 2002/06/25 16:02:37 troberts Exp $

include Makefile.h

# SOURCEDIR is path relative to this 'make'
SOURCEDIR = ${srcdir}
# INCLUDE directory  is two  levels up from this SOURCEDIR
INCLUDE = -I${SOURCEDIR}/../../include

# construct a list of source files for makedepend to use
FSRCS := $(wildcard ${SOURCEDIR}/*.F)
HDRS := $(wildcard ${INCLUDE}/*.h) $(wildcard ${INCLUDE}/*/*.h)
FOBJS := $(notdir $(patsubst %.F,%.o,${FSRCS}))

# Sources in this directory depend upon BLOCK DATA references, 
# so there are two targets to make
TARGET1 = lcsd
TARGET2 = lcs

# Block Data object files
BDOBJS = btbd.o cabd.o e0bd.o elbd.o h1bd.o hebd.o inbd.o isbd.o phbd.o pqbd.o
# Object files
OBJS = abran.o ace_tot.o afill.o afill0.o aiangl.o ainput.o ainter.o aiout.o   \
aiouta.o aitota.o ajtest.o alp19.o alp28.o alpha.o amass.o amfp.o angid.o      \
anglen.o angli1.o aptota.o azirn.o bcasc.o bert.o betac.o betad.o bg6b.o       \
bg6c.o bg6ca.o big7.o binin.o binom1.o binter.o boost.o bovera.o branch.o      \
calcu.o cascad.o cascas.o cbreak.o cbrset.o ccpes.o cep.o ch2.o ch3.o cii.o    \
cij.o clect.o clmb1.o clmb2.o clmb3.o cma.o cmb.o cmc.o cole4.o coll.o         \
collide.o collm.o conprb.o coulmb.o countv.o crdet.o crjab.o crsec.o cut_mc.o  \
datahi.o datalo.o dcintp.o dcnpar.o dcpr.o decay.o defcmg.o delta.o den1.o     \
denk.o dfmax.o dist1.o dost.o drein1.o drein2.o dres.o ecpl.o elas.o elment.o  \
elsc2.o emit.o en.o energy.o errorf.o erup.o eskale.o esneut.o esprot.o eswh.o \
f1.o f2.o f3.o find.o finlii.o finlij.o fint.o fisdis.o fissed.o fixm.o fmax.o \
fnkaon.o fprob.o fsgels.o fsinfo.o gammar.o gamr.o gaurn.o gaussn.o gene.o     \
geo.o get_tot.o geta.o getg.o getwig.o gms.o gthsig.o gtiso.o hcasc.o heh.o    \
hilonx.o hrc.o hyd.o iahn.o iann.o ianp.o idk.o iehn.o ieidxn.o ieidxp.o       \
ienn.o ienp.o ifrist.o igetd.o inevap.o info.o inisbl.o inputf.o insig.o       \
interact.o interp.o isabel.o isedt.o islink.o isob.o keave.o kinels.o kranch.o \
