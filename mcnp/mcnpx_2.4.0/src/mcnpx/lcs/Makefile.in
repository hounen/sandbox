qlp19.o qlp28.o qlpha.o qmaxx.o qngid.o qoll.o qollm.o qou17.o qou18.o qou19.o \
qou21.o qrdet.o qstor.o qsubb.o rebalb.o rebali.o recoil.o redmas.o refl.o     \
