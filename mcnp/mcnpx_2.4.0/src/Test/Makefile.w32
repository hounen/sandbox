# Generated automatically from Makefile.in by configure.
# $Id: Makefile.w32,v 1.1 2002/07/22 17:04:18 jxh Exp $
 
include Makefile.h
# # # # THIS IS THE ROOT MAKEFILE FOR BUILDING TESTS FOR MCNPX # # # #
 
# Use SOURCEDIR to construct path names relative to where this build is taking place.
ifeq (${SYSTEM},Windows)
SOURCEDIR = $(subst /,\,${srcdir})
else
SOURCEDIR = ${srcdir}
endif

 
# DATASRC directory is where ascii files live
DATASRC = ${SOURCEDIR}${/}..${/}..${/}Data${/}LCS
 
# Identify the appropriate machine architecture, operating system, & FORTRAN compiler
TESTARCH = Test.${TARCH}.${TSYS}.${TFC}.${TCC}
 
# Files are named using regular test problem numbers.
# The total list of regular mcnpx test problems is :
PROBS = 01s 02s 03s 04s 05s 06s 07s 08s 09s 10s 11s 12s 13s 14s 15s \
        16s 17s 18s 19s 20s 21s 22s 23s 24s 25s 26s 27s 28s 29s 30s \
        31s 32s 33s 34s 35s 36s 37s 38s 39s 40s 41s 42s 43s 44s 45s \
        46s 47s
# A selected subset of problems that can share a make target is :
SUBSET = 01s 03s 04s 05s 07s 13s 15s 16s 18s 19s 20s 21s 23s 30s 31s \
         32s 33s 34s 35s 36s 37s 38s 39s 40s 41s 42s 43s 44s 45s 46s 47s
# The remaining problems have their own targets.
# * * * * * Look near the middle of this file for regular targets * * * * *
 
# Mesh tally problem numbers have the letter m preprended to avoid conflict
# with regular test problem targets. A sed script removes the m for file naming.
# The total list of mesh tally problems is :
MESH_PROBS = 01m 02m 03m 04m 05m 06m 07m 08m 09m 10m 11m 12m 13m 14m 15m 16m
# A selected subset of mesh tally problems that can share a make target is :
MESH_SUBSET = 01m 02m 03m 04m 05m 06m 07m 08m 09m 10m 11m 12m 13m 14m 15m 16m
# There are no remaining problems with their own targets.
# * * * * * Look near the bottom of this file for mesh tally targets * * * * *
 
# Htape problem numbers have the letters ht preprended to avoid conflict
# with regular test problem targets. A sed script removes the ht for file naming.
# The total list of htape problems is :
HT_PROBS = 01h 02h 03h 04h 05h 06h
# A selected subset of htape problems that can share a make target
HT_SUBSET = 01h 02h 03h 04h
# The remaining problems have their own targets.
# htape cross section problems
XS_PROBS = 05h 06h
# * * * * * Look near the bottom of this file for htape targets * * * * *
 
# The executable programs that are relative to this build dir
MCNPX = ..${/}mcnpx${/}mcnpx
HTAPE = ..${/}htape3x${/}htape3x
XSEX = ..${/}xsex3${/}xsex3

# Default (1st target) does all the tests (regular, mesh tally, htape)
all : tests m-tests ht-tests
 
# There are make targets for mcnpx bertin phtlib htape3x one level up from here
mcnpx bertin phtlib htape3x xsex3 :
	${MAKE} -C ..${/}$@
 
# Force execution every time for phony targets
.PHONY : required in-links out-links
 
# - - - - - - - - - - links - - - - - - - - - - - -
# Establish links to various input files
#    ( inp*, wwinp*, htp* int*, inxs*, mes* )
# Establish links to cross-section files (TestXS/*)
# Establish links to bertin & phtlib libraries
in-links :
	${CP} ${SOURCEDIR}${/}Test_sources${/}inp?? .
	${CP} ${SOURCEDIR}${/}Test_sources${/}htp?? .
	${CP} ${SOURCEDIR}${/}Test_sources${/}int?? .
	${CP} ${SOURCEDIR}${/}Test_sources${/}inxs?? .
	${CP} ${SOURCEDIR}${/}Test_sources${/}mes?? .
	${CP} ${SOURCEDIR}${/}Test_sources${/}wwinp?? .
	${CP} ${SOURCEDIR}${/}TestXS${/}testdir .
	${CP} ${SOURCEDIR}${/}TestXS${/}testlib1 .
	${CP} ..${/}bertin${/}bertin .
	${CP} ..${/}phtlib${/}phtlib .
	${CP} ${DATASRC}${/}barpol.dat .
 
# Establish links to platform specific expected right answer files
# ( outp* wwout* mctl* mdat* mcth* outt* outxs*)
# If the expected set of output files for the given platform do not exist,
# the tests still can be run, but the diff operations will fail.
# Generated output can become the new expected right answers by
# executing 'make generate-test-data' (if you are confident the
# generated output is correct for the platform in use).
out-links :
	${CP} ${SOURCEDIR}${/}${TESTARCH}${/}outp?? .
	${CP} ${SOURCEDIR}${/}${TESTARCH}${/}mctl?? .
	${CP} ${SOURCEDIR}${/}${TESTARCH}${/}wout?? .
	${CP} ${SOURCEDIR}${/}${TESTARCH}${/}mdat?? .
	${CP} ${SOURCEDIR}${/}${TESTARCH}${/}mcth?? .
	${CP} ${SOURCEDIR}${/}${TESTARCH}${/}mcts?? .
	${CP} ${SOURCEDIR}${/}${TESTARCH}${/}outt?? .
	${CP} ${SOURCEDIR}${/}${TESTARCH}${/}outs?? .
	${CP} ${SOURCEDIR}${/}${TESTARCH}${/}outxs?? .
 

# - - - - - - - some utilities - - - - - - - - - - -
# The difm* and difo* files can be listed and counted by making m and o targets
m :
	@${ECHO} " "
	@${LS} -al inp*m htp*m | wc | awk '{print "===========  Expected $(words ${PROBS}) + $(words ${HT_PROBS}) MCTAL files.  Produced " $$1 "  ==========="}' 
	@${LS} -al difm*
	@${LS} -al difm* | wc | awk '{print "=========================  " $$1 " DIFM files  ========================="}'
	@${ECHO} " "
 
# Note that for now, only the standard test problems save OUTP comparison information.
o :
	@${ECHO} " "
	${LS} -al inp*o | wc | awk '{print  "==============  Expected $(words ${PROBS}) OUTP files.  Produced " $$1 "  ============="}' 
	@${LS} -al difo*
	@${LS} -al difo* | wc | awk '{print "=========================  " $$1 " DIFO files  ========================="}'
	@${ECHO} " "
 
# For mesh tally tests, this  lists difd* files, showing the differences in the MDATA files.
d :
	@${ECHO} " "
	@${LS} -al mes*d | wc | awk '{print "=============  Expected $(words ${MESH_PROBS}) MDATA files.  Produced " $$1 "  ============="}'
	@${LS} -al difd*
	@${LS} -al difd* | wc | awk '{print "=========================  " $$1 " DIFD files  ========================="}'
	@${ECHO} " "
 
# For htape tests, this lists dift* files, showing the differences in the OUTT files.
t :
	@${ECHO} " "
	@${LS} -al htp*t | wc | awk '{print "===============  Expected $(words ${HT_PROBS}) OUTT files.  Produced " $$1 "  =============="}'
	@${LS} -al dift*
	@${LS} -al dift* | wc | awk '{print "==========================  " $$1 " DIFT files  ========================="}'
	@${ECHO} " "
 
# For cross-section generation tests, this lists difx* files, showing differences in OUTXS files.
x :
	@${ECHO} " "
	@${LS} -al htp*x | wc | awk '{print "==============  Expected $(words ${XS_PROBS}) OUTXS files.  Produced " $$1 "  =============="}'
	@${LS} -al difx*
	@${LS} -al difx* | wc | awk '{print "==========================  " $$1 " DIFX files  ========================="}'
	@${ECHO} " "
 
# After tests are run, if not all of the dif* files have zero length, the results
# can be examined with this target
examine :
	@for file in `${LS} dif*` ; do \
	  if \
	    test ! -s $${file} ; \
	  then \
	    ${RM} $${file} ; \
	  fi \
	done
	-@${EDITOR} `${LS} dif*`
# - - - - - - - - - - - - - - - - - - - - - - - - - -
 
# % % % % % % % %  Regular Targets % % % % % % % %
# Run mcnpx for all tests to generate output files with current answers
# (to be compared to expected right answers).
# Perform the diff operation on the 2 sets of output files.
 
# You can't do all of the tests if the mcnpx bertin phtlib executables don't exist
required : mcnpx bertin phtlib
 
tests : clean required in-links out-links identify ${PROBS}
	@${ECHO} ""
	@${ECHO} " "
	@${ECHO} "There should be $(words ${PROBS}) non-empty files in the following list:"
	@${ECHO} " "
ifneq (${SYSTEM},Windows)
	@${LS} -al inp*m
	@${ECHO} "-------------------------------"
	@${LS} -al inp*m | wc
else
	@${LS} inp*m
	@${ECHO} "-------------------------------"
endif
	@${ECHO} " "
 
identify :
	@${ECHO} "__________"
	@${ECHO} " Testing: ${MCNPX}"
	@${ECHO} " single-task version."
	@${ECHO} "---------------------"
 
${SUBSET} :
	@${ECHO} "-----------------------------"
	@${ECHO} "-----  Test Problem $@  -----"
	@${ECHO} "-----------------------------"
	${MCNPX} name=inp${@:s=} xsdir=testdir
	-@${COMP} inp${@:s=}m mctl${@:s=} > difm${@:s=}
	-@${COMP} inp${@:s=}o outp${@:s=} > difo${@:s=}
	@${RM} inp${@:s=}r
 
02s 06s 11s :
	@${ECHO} "-----------------------------"
	@${ECHO} "-----  Test Problem $@  -----"
	@${ECHO} "-----------------------------"
	${MCNPX} name=inp${@:s=} xsdir=testdir fatal
	-@${COMP} inp${@:s=}m mctl${@:s=} > difm${@:s=}
	-@${COMP} inp${@:s=}o outp${@:s=} > difo${@:s=}
	@${RM} inp${@:s=}r
 
