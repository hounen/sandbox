# % % % % % % % % % % % % % % % % % % % % % % % % % % % % % %
 
# These next targets are the mesh tally test cases
# To prevent duplication of target names the letter m
# precedes each problem number, but is removed when
# executing the code
# * * * * * * * * * * * * * * * * * * * * Mesh Tally Targets  * * * * * * * * * * * * * * * * * * *
m-tests : clean required in-links out-links m-identify ${MESH_PROBS}
	@${ECHO} ""
	@${ECHO} " "
	@${ECHO} "There should be $(words ${MESH_PROBS}) non-empty files in the following list:"
	@${ECHO} " "
ifneq (${SYSTEM},Windows)
	@${LS} -al mes*m
	@${ECHO} "-------------------------------"
	@${LS} -al mes*m | wc
else
	@${LS} mes*m
	@${ECHO} "-------------------------------"
endif
	@${ECHO} " "
 
m-identify :
	@${ECHO} "__________"
	@${ECHO} " Testing: ${MCNPX}"
	@${ECHO} " mesh tally capability."
	@${ECHO} "-----------------------"
 
${MESH_SUBSET} :
	@${ECHO} "-----------------------------"
	@${ECHO} "-----  Mesh Problem $@  -----"
	@${ECHO} "-----------------------------"
	${MCNPX} name=mes${@:m=} xsdir=testdir
	${CP}  mdata mes${@:m=}d
	-@${COMP} mes${@:m=}m mcts${@:m=} > difsm${@:m=}
	-@${COMP} mes${@:m=}o outs${@:m=} > difso${@:m=}
	-@${RM} mdata
	-@${COMP} mes${@:m=}d mdat${@:m=} > difd${@:m=}
	@${RM} mes${@:m=}r
 
# * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
# These next targets are the htape test cases
# To prevent duplication of target names the letters ht
# precede each problem number, but are removed when
# executing the code
# @ @ @ @ @ @ Htape Targets @ @ @ @ @ @ @ @
 
# You can't do the htape tests if the htape3x executable doesn't exist
ht-req : htape3x xsex3
 
ht-tests : clean required ht-req in-links out-links ht-identify ${HT_PROBS}
	@${ECHO} ""
	@${ECHO} " "
	@${ECHO} "There should be $(words ${HT_PROBS}) non-empty files in the following list:"
	@${ECHO} " "
ifneq (${SYSTEM},Windows)
	@${LS} -al htp*m
	@${ECHO} "-------------------------------"
	@${LS} -al htp*m | wc
else
	@${LS} htp*m
	@${ECHO} "-------------------------------"
endif
	@${ECHO} " "
 
ht-identify :
	@${ECHO} "__________"
	@${ECHO} " Testing: ${MCNPX} and ${HTAPE}"
	@${ECHO} " history file capability."
	@${ECHO} "-------------------------"
 
${HT_SUBSET} :
	@${ECHO} "-----------------------------"
	@${ECHO} "----  Htape Problem $@  -----"
	@${ECHO} "-----------------------------"
	${MCNPX} name=htp${@:h=} xsdir=testdir
	${HTAPE} int=int${@:h=} histx=htp${@:h=}w
	${CP} outt htp${@:h=}t
	-@${RM} outt
	-@${COMP} htp${@:h=}m mcth${@:h=} > difmt${@:h=}
	-@${COMP} htp${@:h=}t outt${@:h=} > dift${@:h=}
	@${RM} histp htp${@:h=}r htp${@:h=}w opt*
 
${XS_PROBS} :
	@${ECHO} "-----------------------------"
	@${ECHO} "----  Htape Problem $@  -----"
	@${ECHO} "-----------------------------"
	${MCNPX} name=htp${@:h=} xsdir=testdir
	${HTAPE} int=int${@:h=}
	${CP} outt htp${@:h=}t
	-@${RM} outt
	${XSEX} inxs=inxs${@:h=}
	${CP} outxs htp${@:h=}x
	-@${RM} outxs
	-@${COMP} htp${@:h=}m mcth${@:h=} > difmt${@:h=}
	-@${COMP} htp${@:h=}t outt${@:h=} > dift${@:h=}
	-@${COMP} htp${@:h=}x outxs${@:h=} > difx${@:h=}
	@${RM} histp htp${@:h=}r htp${@:h=}w opt*
 
# @ @ @ @ @ @ @ @ @ @ @ @ @ @ @ @ @ @ @ @ @ @ @ @
# The next 2 targets allow for generation of the expected
# right answer files.
# WARNING - THIS DOES ALL FILES, NOT A SUBSET OF FILES
# See individual targets for replacing or creating subsets.
 
generate-test-data :
ifneq (${SYSTEM},Windows)
	-@if test -d ${SOURCEDIR}${/}${TESTARCH} ; then \
		${ECHO} "Replacing existing ${SOURCEDIR}${/}${TESTARCH} data."; \
		${RM} ${SOURCEDIR}${/}${TESTARCH}${/}*; \
		${MAKE} ${MFLAGS} copy-data; \
	else \
		${ECHO} "Creating new ${SOURCEDIR}${/}${TESTARCH} data."; \
		mkdir -p ${SOURCEDIR}${/}${TESTARCH}; \
		${MAKE} ${MFLAGS} copy-data; \
	fi
else
	-@mkdir ${SOURCEDIR}${/}${TESTARCH}
	${MAKE} ${MFLAGS} copy-data
endif

copy-data : gen-outp gen-mctl gen-wout gen-outs gen-mcts gen-mdat gen-outt gen-mcth gen-outxs

# Individual targets for replacing/creating just subsets of blessed answers
gen-outp : ${PROBS:s=s1}

${PROBS:s=s1} :
	@${CP} inp${@:s1=}o ${SOURCEDIR}${/}${TESTARCH}${/}outp${@:s1=}

gen-mctl : ${PROBS:s=s2}

${PROBS:s=s2} :
	@${CP} inp${@:s2=}m ${SOURCEDIR}${/}${TESTARCH}${/}mctl${@:s2=}

gen-wout : 08s3 10s3 12s3 14s3

08s3 10s3 12s3 14s3 :
	@${CP} inp${@:s3=}e ${SOURCEDIR}${/}${TESTARCH}${/}wout${@:s3=}

gen-outs : ${MESH_PROBS:m=m1}

${MESH_PROBS:m=m1} :
	@${CP} mes${@:m1=}o ${SOURCEDIR}${/}${TESTARCH}${/}outs${@:m1=}

gen-mcts : ${MESH_PROBS:m=m2}

${MESH_PROBS:m=m2} :
	@${CP} mes${@:m2=}m ${SOURCEDIR}${/}${TESTARCH}${/}mcts${@:m2=}

gen-mdat : ${MESH_PROBS:m=m3}

${MESH_PROBS:m=m3} :
	@${CP} mes${@:m3=}d ${SOURCEDIR}${/}${TESTARCH}${/}mdat${@:m3=}

gen-outt : ${HT_PROBS:h=h1}

${HT_PROBS:h=h1} :
	@${CP} htp${@:h1=}t ${SOURCEDIR}${/}${TESTARCH}${/}outt${@:h1=}

gen-mcth : ${HT_PROBS:h=h2}

${HT_PROBS:h=h2} :
	@${CP} htp${@:h2=}m ${SOURCEDIR}${/}${TESTARCH}${/}mcth${@:h2=}

gen-outxs : ${XS_PROBS:h=h3}

${HT_PROBS:h=h3} :
	@${CP} htp${@:h3=}x ${SOURCEDIR}${/}${TESTARCH}${/}outxs${@:h3=}

# The next 2 targets are for cleaning up the directory.
# get rid of all the links and generated output from any/all target building activity above
clean :
	@-${RM} bertin phtlib testlib1 testdir mes* htp* int* inp* wwinp*
	@-${RM} inxs* outxs* mctl* outp* wout* mdat* outt* mcth* mcts* outs*
	@-${RM} difd* dife* dift* difm* difo* difx* tmp* difso* difsm*
	@-${RM} core barpol.dat *.out out? opt* histp* wxxa wxxb
 
distclean :
	@-${RM} ${DISTCLEANFILES}
	@-${RM} ${CONFFILES}
