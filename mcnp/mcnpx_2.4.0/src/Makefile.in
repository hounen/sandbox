# $Id: Makefile.in,v 1.15 2002/06/14 22:54:38 troberts Exp $

include Makefile.h
# # # # This is the src level  MAKEFILE for building MCNPX # # # #

# SOURCEDIR is path relative to this 'make'
SOURCEDIR = ${srcdir}

# Default target is first target - 'make' defaults to 'make all'.
all : gridconv bertin htape3x makxs phtlib xsex3 mcnpx

# You should not install until you 'make all' and 'make tests'
# We only enforce 'make all'
install : all
	@${SOURCEDIR}/../config/install-sh -c ${SOURCEDIR}/../Data/LCS/barpol.dat ${datadir}/barpol.dat
	@${ECHO} "Install of barpol.dat  into ${datadir} complete."
	@${MAKE} -C bertin install
	@${MAKE} -C phtlib install
	@${MAKE} -C mcnpx install
	@${MAKE} -C gridconv install
	@${MAKE} -C htape3x install
	@${MAKE} -C xsex3 install
	@${MAKE} -C makxs install

# Source code for targets are not at the src level directory.
# Sources are at the next level (or multiple levels) down.

# Force execution of 'make' every time for phony targets,
# otherwise the matching directory names give the appearance
# that everything is up to date.
.PHONY : gridconv bertin htape3x makxs phtlib xsex3 mcnpx tests

# Targets with matching subdirectories 
mcnpx gridconv htape3x makxs xsex3 bertin phtlib:
	${MAKE} -C $@ all

# Target tests has non-matching subdirectory
# and depends on mcnpx bertin phtlib barpol targets
# Data to use with tests is new cross-section physics only
tests : mcnpx bertin phtlib barpol
	${MAKE} -C Test all

# Maintain a maping back to old individual test target names
single meshtal htape : 
	${MAKE} -C Test $@

# Target barpol occurs in the Test subdirectory
barpol :
	${MAKE} -C Test $@

# The m, o, d, t, x, examine targets are for convenience utilities
# when looking at test results - pass them down.
.PHONY : m o d t x examine
m o d t x examine :
	${MAKE} -C Test $@

# Force 'make' to execute every time for PHONY targets.
.PHONY : clean distclean 

# Target clean should remove intermediate files and .o files but leave executables alone
clean  :
	@-${RM}  ${CLEANFILES}
	@${MAKE} -C ./gridconv clean
	@${MAKE} -C ./bertin clean
	@${MAKE} -C ./htape3x clean
	@${MAKE} -C ./makxs clean
	@${MAKE} -C ./phtlib clean
	@${MAKE} -C ./xsex3 clean
	@${MAKE} -C ./mcnpx clean
	@${MAKE} -C ./Test clean

# Target distclean should clean then remove executables and dependency files
distclean : clean
	@-${RM} ${DISTCLEANFILES}
	@-${RM} ${CONFFILES}
	@${MAKE} -C ./gridconv distclean
	@${MAKE} -C ./bertin distclean
	@${MAKE} -C ./htape3x distclean
	@${MAKE} -C ./makxs distclean
	@${MAKE} -C ./phtlib distclean
	@${MAKE} -C ./xsex3 distclean
	@${MAKE} -C ./mcnpx distclean
	@${MAKE} -C ./Test distclean

# DO NOT DELETE THIS LINE - makedepend depends on it
