#!/bin/sh
# requires GNU find
#
# This script is a support tool for mcnpx when checking in or out
# code from a CS repository. It creates a script typically saved
# as "make-links" that ensures that a tree of files contains
# only those symlinks that were in place when this script was run.
#
# The purpose of this script is to automatically construct
# the make-links script given an existing mcnpx tree with the
# desired existing set of links. The ONLY time this script
# need be run is when the programmer adds or removes a link
# from the existing set. If such a change is made, run this
# script in the top level of the mcnpx tree as
#    ./make-link-script >make-links
# and make sure the resulting make-links file has execute
# file permissions.
# of course, the script can just be run as
#    ./make-link-script | more
# if you want to see what it generates.
#
# Finally, note that this script requires GNU find in order to
# support the -printf arg used below.
#
# The reason this mechanism is needed:
# CVS basically ignores symbolic links.
# The mcnpx tree contains many symbolic links.
# When the mcnpx tree is checked into CVS, the symbolic links
# are not stored. Upon either checkout or export from CVS, a
# script is needed that restores the symbolic links to the tree.
# This is performed by the script named "make-links" created by
# this script that is stored in the top of
# the mcnpx source tree.
#
########################
#
# For a LOCAL repository:
#     (CVSROOT=/foo/bar/baz on a local filesystem)
#
# The "make-links" script is fired off by CVS under control
# of the CVS "modules" file. If a user does a
#    cvs checkout CVSROOT
# to get the cvs administrative files, and then
# examines the CVSROOT/modules file, a line will be found that
# looks like
#    mcnpx -e mcnpx/make-links \
#          -o mcnpx/make-links \
#          -u mcnpx/make-links mcnpx
# which says that for module mcnpx, on export, update, or checkout,
# run "make-links" from the top level of the mcnpx tree.
# The "make-links" script rebuilds all the symbolic links.
# This script generates the needed "make-links" script.
#
########################
#
# For a REMOTE repository using client/server CVS:
#     (CVSROOT=:pserver:...
#      CVSROOT=:ext:...
#      or any of the other client/server modes)
#
# CVS states that it runs the modules programs for checkout and
# export on the SERVER, which doesn't help us at all. The
# "make-links" script has to be run on the CLIENT. For the
# module update program, the CVS documentation states that
# the program is run on the client, but my tests show that
# update also runs the program on the server. (this is probably
# a CVS bug.) This is as of cvs version 1.11
#
# The result is that the user must manually run the link script
# to create the links upon checkout, export, or update from
# a remote repository. Do this by:
#   cvs checkout mcnpx
#   mcnpx/make-links mcnpx
#
########################
#
echo '#!/bin/sh'
echo '# Generated by make-link-script of '
echo '# ' `pwd`
echo '#'
echo '# On ' `date`
echo '#'
echo 'if [ $# -ne 1 ]; then'
echo '   echo This script should only be run by CVS'
echo '   echo Usage $0 module-path'
echo '   exit'
echo 'else'
echo '   cd $1'
echo 'fi'
echo 'find . -type l -exec rm \{\} \;'
find . -type l -printf '(cd %h; ln -s %l %f)\n'
# /usr/lanl/gnu/packages/findutils-4.1/bin/find . -type l -printf '(cd %h; ln -s %l %f)\n'
